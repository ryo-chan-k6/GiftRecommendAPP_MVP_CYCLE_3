# Build context = repository root (cwd when running fly deploy).
# Keep only apps/reco runtime inputs.

*
!apps/
apps/*
!apps/reco/
!apps/reco/pyproject.toml
!apps/reco/uv.lock
!apps/reco/README.md
!apps/reco/src/
!apps/reco/src/**
apps/reco/tests/
apps/reco/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
