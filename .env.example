# Gift Recommendation Service - environment variable names (local development)
#
# 正本: docs/06_実装設計/cross_cutting/環境設計書.md §19
# 使い方: 本ファイルを .env にコピーし、ローカル用の値を設定する。
# 注意: .env は Git 管理しない。本ファイルにはダミー値のみ記載する。
#
# 秘匿性区分の詳細は環境設計書 §19.1 を参照。
# MVP では web から Supabase 直結しないため SUPABASE_ANON_KEY は含めない。

# =============================================================================
# Common（全アプリ） §19.3
# =============================================================================

# config | MVP必須 | 実行環境識別（dev / stg / prod）
APP_ENV=dev

# config | MVP任意 | ログ出力レベル
LOG_LEVEL=info

# =============================================================================
# Shared infrastructure（api / reco / batch 共通） §19.5 / §19.6 / §19.7
# =============================================================================

# secret | MVP必須 | PostgreSQL 接続（api / reco / batch）
# Supabase CLI ローカル既定（port 54322）。クラウド dev 等では supabase status / ホスティングの URL に合わせる
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# secret | MVP必須 | Redis 接続（api / reco）
REDIS_URL=redis://localhost:6379/0

# secret | MVP必須 | Embedding / LLM API（reco / batch）
OPENAI_API_KEY=your_openai_api_key_here

# secret | MVP必須 | api → reco Internal API 認証（api / reco で同一値）
RECO_INTERNAL_API_KEY=your_reco_internal_api_key_here

# =============================================================================
# apps/web §19.4
# Web は server-side secret を保持しない（認証・認可方針書 §17.2）
# =============================================================================

# public-config | MVP必須 | ブラウザから API への Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# config | MVP任意 | Server Component 等からの API 参照（NEXT_PUBLIC_* と同値推奨）
API_BASE_URL=http://localhost:3001

# =============================================================================
# apps/api §19.5
# =============================================================================

# config | MVP必須 | Reco サービス Base URL
RECO_BASE_URL=http://localhost:8000

# config | MVP必須 | CORS allowlist（カンマ区切り等）
CORS_ALLOWED_ORIGINS=http://localhost:3000

# config | MVP任意 | 待受ポート（ホスティング注入時は省略可）
# PORT=3001

# secret | MVP任意 | JWT 署名用（MVP 匿名利用時は未使用可）
# JWT_SECRET=your_jwt_secret_here

# secret / config | MVP任意 | Supabase 採用時のみ（Neon 直結時は不要）
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# apps/reco §19.6
# =============================================================================

# config | MVP任意 | 待受ポート（ホスティング注入時は省略可）
# PORT=8000

# =============================================================================
# apps/batch §19.7
# 物理名正本: RAKUTEN_APPLICATION_ID / OBJECT_STORAGE_*（§19.7.1）
# =============================================================================

# secret | MVP必須 | 楽天 API 認証
RAKUTEN_APPLICATION_ID=your_rakuten_application_id_here
RAKUTEN_ACCESS_KEY=your_rakuten_access_key_here

# config | live検証必須 | 楽天に登録した接続元外部IP（不一致時はHTTPしない）
# RAKUTEN_EXPECTED_EGRESS_IP=203.0.113.10

# config | live検証任意 | クライアント目標QPS（既定8、ハードキャップ10）
# RAKUTEN_MAX_QPS=8

# config | live検証任意 | 呼出最小間隔ms（未設定時は QPS から算出。100未満は拒否）
# RAKUTEN_MIN_INTERVAL_MS=125

# config | MVP必須 | Raw 保存先 bucket
OBJECT_STORAGE_BUCKET=your_object_storage_bucket_here

# config | MVP任意 | S3 互換 Storage endpoint（クラウド既定利用時は省略可）
# OBJECT_STORAGE_ENDPOINT=https://your-object-storage-endpoint.example.com

# secret | MVP必須 | Object Storage 接続
OBJECT_STORAGE_ACCESS_KEY=your_object_storage_access_key_here
OBJECT_STORAGE_SECRET_KEY=your_object_storage_secret_key_here

# secret | MVP任意 | Batch 起動制御（MVP は GitHub Actions 手動/定期実行を基本）
# BATCH_INTERNAL_TOKEN=your_batch_internal_token_here

# config | MVP任意 | Batch 実行パラメータ
# BATCH_CHUNK_SIZE=100
# BATCH_MAX_RETRY=3
